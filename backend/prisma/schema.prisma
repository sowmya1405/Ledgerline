generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER ROLES
enum Role {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
}

// ACCOUNT TYPES
enum AccountType {
  CUSTOMER
  SYSTEM
}

// ACCOUNT STATUS
enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// TRANSACTION TYPES
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

// TRANSACTION STATUS
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// LEDGER ENTRY TYPES
enum EntryType {
  DEBIT
  CREDIT
}

// USER MODEL
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(ACCOUNT_HOLDER)

  accounts     Account[]
  transactions Transaction[]       @relation("InitiatedTransactions")
  idempotency  IdempotencyRecord[]
  auditLogs    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ACCOUNT MODEL
model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  type          AccountType   @default(CUSTOMER)
  balance       BigInt        @default(0)
  status        AccountStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  ledgerEntries LedgerEntry[]

  outgoingTransactions Transaction[] @relation("SourceAccount")
  incomingTransactions Transaction[] @relation("DestinationAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TRANSACTION MODEL
model Transaction {
  id          String            @id @default(uuid())
  reference   String            @unique
  type        TransactionType
  amount      BigInt
  status      TransactionStatus @default(PENDING)
  description String?

  sourceAccountId      String?
  destinationAccountId String?

  sourceAccount      Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  initiatedById String
  initiatedBy   User   @relation("InitiatedTransactions", fields: [initiatedById], references: [id])

  ledgerEntries LedgerEntry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// LEDGER ENTRY MODEL
model LedgerEntry {
  id            String    @id @default(uuid())
  transactionId String
  accountId     String
  entryType     EntryType
  amount        BigInt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  account     Account     @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([accountId])
}

// IDEMPOTENCY MODEL
model IdempotencyRecord {
  id            String  @id @default(uuid())
  key           String
  requestHash   String
  transactionId String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, key])
}

// AUDIT LOG MODEL
model AuditLog {
  id       String @id @default(uuid())
  action   String
  entity   String
  entityId String
  details  Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
